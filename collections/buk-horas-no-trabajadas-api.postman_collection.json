            "description": {
              "content": "Retorna un listado de las horas no trabajadas acumuladas de los trabajadores de un recinto especifico en un rango de fechas. El rango de fechas no puede exceder los 35 días. Ademas, se puede filtrar la lista por el DNI del coloborador.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "obtenerHorasNoTrabajadas"
              ],
              "host": [
                "{{obtenerHorasNoTrabajadas-Url}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "obra_id",
                  "value": "<integer>",
                  "description": "(Required) Identificador único del recinto asociado a los trabajadores."
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<string>",
                  "description": "(Required) Fecha de inicio del rango de consulta para las inasistencias. Formato esperado \"DD-MM-AAAA\""
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<string>",
                  "description": "(Required) Fecha finalización del rango de consulta para las inasistencia. Formato esperado \"DD-MM-AAAA\""
                },
                {
                  "disabled": false,
                  "key": "dni_colaborador",
                  "value": "<string>",
                  "description": "DNI del colaborador para filtrar la búsqueda. Si se omite, se incluirán todos los trabajadores."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Número de la página. Si no se proporciona, se asume la primera página (1)."
