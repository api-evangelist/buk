          "name": "inasistencia",
          "request": {
            "name": "inasistencia",
            "description": {
              "content": "Retorna un listado de las inasistencia de los trabajadores de un recinto especifico para un rango de fechas. El periodo esta limitado a un máximo de 35 dias. Ademas, se puede filtrar la lista por el DNI del colaborador.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "obtenerInasistencias"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "obra_id",
                  "value": "<integer>",
                  "description": "(Required) Identificador único del recinto asociado a los trabajadores."
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<string>",
                  "description": "(Required) Fecha de inicio del rango de consulta para las inasistencias. Formato esperado \"DD-MM-AAAA\""
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<string>",
                  "description": "(Required) Fecha finalización del rango de consulta para las inasistencia. Formato esperado \"DD-MM-AAAA\""
                },
                {
                  "disabled": false,
                  "key": "dni_colaborador",
                  "value": "<string>",
                  "description": "DNI del colaborador para filtrar la búsqueda. Si se omite, se incluirán todos los trabajadores."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Número de la página. Si no se proporciona, se asume la primera página (1)."
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "<integer>",
                  "description": "Tamaño de la página, con un valor máximo permitido de 100. Si no se proporciona, se utiliza un tamaño de página predeterminado (25)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
