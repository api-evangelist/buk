        {
          "id": "458a5e1b-0e02-4f28-b72d-21c12a7819cd",
          "name": "Create a time off type",
          "request": {
            "name": "Create a time off type",
            "description": {
              "content": "Creates a type of time off in the system.\n\nA LicenceType object must be sent as a JSON object in the\nthe body of the request, composed of the following attributes:\n - code: Unique code that identifies the time off\n - name: Name of type of time off\n - description: Description of type of time off\n with_pay: whether it includes salary payment or not (optional, by default is false)\n requestable: whether the type of time off can be requested by the Colaborador (optional, by default is false)\n\n\n **Permisos requeridos para utilizar este endpoint:** \n* Attendance permissions en: 'Lectura y Modificación'.\n",
              "type": "text/plain"
            },
