          "name": "Add a document to employee",
          "request": {
            "name": "Add a document to employee",
            "description": {
              "content": "We receive a document, which will be related to the employee.\n\n**Permisos requeridos para utilizar este endpoint:** \n* Permissions to upload documents en: 'Sí'.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "employees",
                ":id",
                "docs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "Visible to the employee. Default: false (This can only be one of true,false)",
                    "type": "text/plain"
                  },
                  "key": "visible",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Requires employee signature. Default: false (This can only be one of true,false)",
                    "type": "text/plain"
                  },
                  "key": "signable_by_employee",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Requires the signature of the legal representative. Default: false (This can only be one of true,false)",
                    "type": "text/plain"
                  },
                  "key": "signable_by_legal_agent",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Requires the signature of a second legal representative. Default: false (This can only be one of true,false)",
                    "type": "text/plain"
                  },
                  "key": "signable_by_second_legal_agent",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Overwrite file. Applies only to documents that do not have all required signatures. Default: false (This can only be one of true,false)",
                    "type": "text/plain"
                  },
                  "key": "overwrite",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Start automatic signature flow The document must be visible and must have signature or review requirements to select this option. Default: false (This can only be one of true,false)",
                    "type": "text/plain"
                  },
                  "key": "start_signature_workflow",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Path where the file will be saved. If left blank it will be created in the employee's root folder. Example: personal/security",
                    "type": "text/plain"
                  },
                  "key": "path",
                  "value": ""
                },
                {
                  "disabled": false,
                  "key": "signatures",
                  "value": "{\"value\":\"reference #/definitions/DocumentSignature not found in the OpenAPI spec\"}",
                  "description": "Array of objects of signature type. It is an optional parameter. If this parameter is used, the other parameters related to the signature will not be taken into account."
