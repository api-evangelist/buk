{
  "opencollection": "1.0.0",
  "info": {
    "name": "Buk Turnos API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Turnos",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "asignacionTurnos",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.ctrlit.cl/ctrl/api/getAsignacionTurnos",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "query",
                "description": "Identificador de la empresa"
              },
              {
                "name": "desde",
                "value": "",
                "type": "query",
                "description": "Fecha de incio de la busqueda en formato dia-mes-año. En el caso de omitirlo se tomara el dia de ayer por defecto."
              },
              {
                "name": "hasta",
                "value": "",
                "type": "query",
                "description": "Fecha de finalización de la busqueda en formato dia-mes-año. En el caso de omitirlo se tomara el dia de hoy por defecto."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Número de la página. Si no se proporciona, se asume la primera página (1)."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Cantidad de resultados por página."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "token",
              "value": "{{token}}",
              "placement": "header"
            }
          },
          "docs": "Retorna un listado de los datos de trabajador junto con toda la informacion sobre los turnos. El endpoint esta paginado, con un máximo de 1000 elementos por página."
        }
      ]
    }
  ],
  "bundled": true
}