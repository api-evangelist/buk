          "name": "horas Extras",
          "request": {
            "name": "horas Extras",
            "description": {
              "content": "Retorna un listado de las horas extras aprobadas de los trabajadores de un recinto especifico en un rango de fechas. El rango de fechas no puede exceder los 35 días. Ademas, se puede filtrar la lista por el DNI del coloborador. El reporte presenta los tipos de horas extras y el total de horas extras en el intervalo indicado.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "obtenerHorasExtras"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "obra_id",
                  "value": "<integer>",
                  "description": "(Required) Identificador único del recinto asociado a los trabajadores."
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<string>",
                  "description": "(Required) Fecha de inicio del rango de consulta para las inasistencias. Formato esperado \"DD-MM-AAAA\""
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<string>",
                  "description": "(Required) Fecha finalización del rango de consulta para las inasistencia. Formato esperado \"DD-MM-AAAA\""
                },
                {
                  "disabled": false,
                  "key": "dni_colaborador",
                  "value": "<string>",
                  "description": "DNI del colaborador para filtrar la búsqueda. Si se omite, se incluirán todos los trabajadores."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Número de la página. Si no se proporciona, se asume la primera página (1)."
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "<integer>",
                  "description": "Tamaño de la página, con un valor máximo permitido de 100. Si no se proporciona, se utiliza un tamaño de página predeterminado (25)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
