            "name": "List absence request types",
            "description": {
              "content": "Displays the list of absence request types in the system.\n\nThe filter with salary payment (with_pay) is optional.\n\n\n**Permisos requeridos para utilizar este endpoint:** \n* Attendance permissions en: 'Lectura' o 'Lectura y Modificación'.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "absences",
                "permission",
                "types"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "(OPTIONAL) paid?",
                    "type": "text/plain"
                  },
                  "key": "with_pay",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(OPTIONAL) Absence Request type (This can only be one of per_day,per_hour,both)",
                    "type": "text/plain"
                  },
                  "key": "time_measure",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(OPTIONAL) Number of answers per page. By default it has a value of 25 and must be within a range of [25 - 100].",
