          "id": "79572799-ee7e-48bd-bc2e-dabb1ba53818",
          "name": "Show Worked Days",
          "request": {
            "name": "Show Worked Days",
            "description": {
              "content": "Provides information about the days worked for each Colaborador.\n\nA type of Worked Day has the following attributes:\n- employee_id: unique identifier of the Colaborador\n- document_number: Document Number of the Colaborador\n- document_type: Type of Document of the Colaborador\n- code: file code of the Colaborador\n- working_days: total number of days worked\n- working_days_dates: dates of the days worked\n\n**Permisos requeridos para utilizar este endpoint:** \n* Attendance permissions en: 'Lectura'.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "working_days"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "(OPTIONAL) Indicates the starting date of the worked days (Format YYYYY-MM-DD)",
                    "type": "text/plain"
                  },
                  "key": "from",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(OPTIONAL) Indicates the end date of the worked days (Format YYYYY-MM-DD)",
                    "type": "text/plain"
                  },
                  "key": "to",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(OPTIONAL) Document Number of the Colaborador",
                    "type": "text/plain"
                  },
                  "key": "document_number",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(OPTIONAL) Colaborador file code",
                    "type": "text/plain"
                  },
                  "key": "code",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(OPTIONAL) Number of answers per page. By default it has a value of 25 and must be within a range of [25 - 100].",
                    "type": "text/plain"
                  },
                  "key": "page_size",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(OPTIONAL) Page number",
                    "type": "text/plain"
                  },
                  "key": "page",
                  "value": ""
                }
              ],
