          "name": "Centralized accounting",
          "request": {
            "name": "Centralized accounting",
            "description": {
              "content": "It allows to obtain the accounting information corresponding to a specific month.\nThe items are grouped by the pay stub to which they belong.\n\n**Permisos requeridos para utilizar este endpoint:** \n* Accounting permissions en: 'Lectura'.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounting"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "Queried Month (1 - 12) MANDATORY if process_id is not specified. If process_id is specified, MONTH will be ignored.",
                    "type": "text/plain"
                  },
                  "key": "month",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Queried Year MANDATORY if process_id is not specified. If process_id is specified, YEAR will be ignored.",
                    "type": "text/plain"
                  },
                  "key": "year",
                  "value": ""
                },
                {
                  "description": {
                    "content": "ID of the process to be queried. MANDATORY if year and month is not specified",
                    "type": "text/plain"
                  },
                  "key": "process_id",
                  "value": ""
                },
                {
                  "description": {
                    "content": "ID or RUT of the Empresa to be queried.",
                    "type": "text/plain"
                  },
                  "key": "company_id",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(OPTIONAL) Number of answers per page. By default it has a value of 25 and must be within a range of [25 - 100]",
                    "type": "text/plain"
                  },
                  "key": "page_size",
                  "value": ""
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": null
          },
          "response": [
