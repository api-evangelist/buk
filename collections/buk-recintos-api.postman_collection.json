        {
          "id": "f39fbd18-601c-4a15-90c2-55254b577173",
          "name": "Show Recintos",
          "request": {
            "name": "Show Recintos",
            "description": {
              "content": "Retrieve information for each Recinto\n\nA Recinto has the following attributes::\n- name: Recinto name\n- code: Recinto code\n- location_id: ID of the Commune where the Recinto is located (you can check the endpoint GET /locations))\n- city: City\n- address_name: Street name of the Recinto\n- address_number: Street number of the Recinto\n- address_optional: Description of the address\n- latitude: Latitude of the Recinto\n- longitude: Recinto longitude\n- postcode: Recinto Zip Code\n- integrated_with_ctrl: Integration with CTRL\n- establishment_code: Recinto Code\n\n\nEste endpoint no requiere permisos especiales.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "recintos"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "- code: Recinto code (OPTIONAL)",
                    "type": "text/plain"
