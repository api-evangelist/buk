                "benefit_requests"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "(OPTIONAL) Request status. Allowed values: in_process, approved, rejected, pre_approved, incomplete, cancel_request, canceled",
                    "type": "text/plain"
                  },
                  "key": "status",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(OPTIONAL) ID of the person who requested the benefit. Used to filter requests from a specific person.",
                    "type": "text/plain"
                  },
                  "key": "person_id",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(OPTIONAL) ID of the specific version of the requested benefit.",
                    "type": "text/plain"
                  },
                  "key": "available_version_id",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(OPTIONAL) Date from which to filter requests (format: YYYY-MM-DD). Allows searching for requests made from a specific date onwards",
                    "type": "text/plain"
                  },
                  "key": "requested_at_from",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(OPTIONAL) Date up to which to filter requests (format: YYYY-MM-DD). Allows searching for requests made up to a specific date",
                    "type": "text/plain"
                  },
                  "key": "requested_at_to",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(OPTIONAL) Page number for result pagination. Defaults to 1 if not specified",
                    "type": "text/plain"
                  },
                  "key": "page",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(OPTIONAL) Number of records per page (maximum 100). Default is 25 if not specified",
                    "type": "text/plain"
                  },
                  "key": "per_page",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(OPTIONAL) Field by which to sort the results. Allowed values: id, person_id, approver_id, available_version_id, status, points_cost, requested_at, status_date, created_at",
                    "type": "text/plain"
                  },
                  "key": "sort_by",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(OPTIONAL) Sort direction. Allowed values: asc (ascending), desc (descending). Default is desc (This can only be one of asc,desc)",
                    "type": "text/plain"
                  },
                  "key": "sort_order",
                  "value": ""
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": null
