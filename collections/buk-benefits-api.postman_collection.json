          "name": "List all benefit requests",
          "request": {
            "name": "List all benefit requests",
            "description": {
              "content": "This endpoint returns all benefit requests.\n\n\n**Permisos requeridos para utilizar este endpoint:** \n* Benefit permissions en: 'Lectura'.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
