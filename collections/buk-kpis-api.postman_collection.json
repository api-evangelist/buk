        {
          "id": "8f6a18fc-9866-41c4-9e3f-a1d06d7a8a89",
          "name": "Listar tipos de KPI",
          "request": {
            "name": "Listar tipos de KPI",
            "description": {
              "content": "Retorna todos los tipos de KPI registrados en el sistema\n\nUn tipo de KPI posee los siguientes atributos\n- id: identificador único del tipo de KPI\n- name: nombre descriptivo\n- code: código interno\n- related_to: nombre de entidad a la que se asocia el tipo de KPI\n- units: unidad de medida del tipo de KPI\n\n\n**Permisos requeridos para utilizar este endpoint:** \n* Permisos de tipos de KPI en: 'Lectura'.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "kpis"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "Filtra los tipos de KPI con este nombre",
                    "type": "text/plain"
                  },
                  "key": "name",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Filtra los tipos de KPI con este código",
                    "type": "text/plain"
                  },
                  "key": "code",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Filtra los tipos de KPI con esta entidad asociada",
                    "type": "text/plain"
                  },
                  "key": "related_to",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Filtra los tipos de KPI con esta unidad de medida",
                    "type": "text/plain"
                  },
                  "key": "units",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(OPCIONAL) Número de respuestas por página. Por defecto tiene un valor de 25 y debe estar entre un rango de [25 - 100]",
                    "type": "text/plain"
                  },
                  "key": "page_size",
                  "value": ""
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "245f5c91-be39-4e93-be00-13be87c7f9ce",
              "name": "Como respuesta recibimos un arreglo (data) con la información de los tipos de KPI",
