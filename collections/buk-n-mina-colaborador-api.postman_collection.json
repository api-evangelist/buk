            "description": {
              "content": "Retorna una lista de trabajadores asociados a una empresa específica, incluyendo detalles como DNI, contrato y estado laboral. Se pueden aplicar filtros por ID del recinto y estado del vínculo laboral y por un trabajador.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "obtenerNominaColaborador"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "obra_id",
                  "value": "<integer>",
                  "description": "Identificador único del recinto asociado a los trabajadores. Si se omite, la búsqueda incluirá todos los recintos."
                },
                {
                  "disabled": false,
                  "key": "dni_colaborador",
                  "value": "<string>",
                  "description": "DNI del colaborador para filtrar la búsqueda. Si se omite, se incluirán todos los trabajadores."
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Estado de vinculación de los trabajadores con la empresa."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Número de la página. Si no se proporciona, se asume la primera página (1)."
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "<integer>",
                  "description": "Tamaño de la página, con un valor máximo permitido de 100. Si no se proporciona, se utiliza un tamaño de página predeterminado (25)."
