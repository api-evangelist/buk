          "name": "List unexcused absences",
          "request": {
            "name": "List unexcused absences",
            "description": {
              "content": "Displays the unexcused absence of each type registered in the system within a date range (optional).\nThe unexcused absences types are:\n\n- leave: Para una leave Médica\n- absence: For an unexcused absence\n- leave: For an unpaid absence request\n- paid_leave: For a paid absence request\n\nDates must be in YYYYY-MM-DD format.\nFilters by type and date are optional.\n\n**Permisos requeridos para utilizar este endpoint:** \n* Attendance permissions en: 'Lectura' o 'Lectura y Modificación'.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "absences"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "Start date of the range in YYYY-MM-DD format.",
                    "type": "text/plain"
                  },
                  "key": "from",
                  "value": ""
                },
                {
                  "description": {
                    "content": "End date of the range in YYYY-MM-DD format.",
                    "type": "text/plain"
                  },
                  "key": "to",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Unexcused absence type (This can only be one of licence,absence,leave,paid_leave)",
                    "type": "text/plain"
                  },
                  "key": "type",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(OPTIONAL) Number of answers per page. By default it has a value of 25 and must be within a range of [25 - 100]",
                    "type": "text/plain"
                  },
                  "key": "page_size",
                  "value": ""
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": null
          },
